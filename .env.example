# String de conexão do Supabase (Project Settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.xxxx.supabase.co:5432/postgres

PORT=3000

# Senha de entrada do painel da cozinha (/#/painel). Use algo longo.
PAINEL_SENHA=troque-esta-senha

# Segredo que assina o token de login do painel. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAINEL_SEGREDO=troque-por-um-valor-aleatorio-longo
